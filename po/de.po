msgid "Replay Buffer"
msgstr "Wiederholungspuffer"

#: package/contents/ui/configAppearance.qml:362
msgid "Replay buffer:"
msgstr "Wiederholungspuffer:"

#: package/contents/ui/configAppearance.qml:363
msgid "Start automatically when OBS connects"
